APP_NAME=MINT
APP_ENV=development
DEBUG=true

# PostgreSQL (docker compose) or SQLite for local dev without Docker:
DATABASE_URL=sqlite:///./mint_dev.db
# DATABASE_URL=postgresql+psycopg://mint_user:mint_password@localhost:5432/mint_db

# Dedicated schema for managed PostgreSQL (avoids public schema CREATE restrictions)
DB_SCHEMA=mint

# Tables are auto-created on startup (create_all). For production schema changes, use Alembic.

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

LLM_PROVIDER=gemini
TRANSLATE_TITLES_ON_CRAWL=true
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-2.5-flash-lite
GEMINI_REPORT_MODEL=gemini-2.5-flash
PERSONALIZATION_ENABLED=true
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
REPORT_ILLUSTRATION_ENABLED=true

MEDIA_ROOT=uploads
MEDIA_URL_PREFIX=/media

SLACK_WEBHOOK_ENCRYPTION_KEY=change-me-32-byte-key-here!!!!

# Slack·알림 링크용 공개 프론트 URL (미설정 시 CORS 중 non-localhost 우선)
FRONTEND_URL=https://mint.greenity.cloud

CORS_ORIGINS=http://localhost:5173

SEED_ADMIN_EMAIL=admin@motrexev.com
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_NAME=김민트

# Reddit 커뮤니티 수집 (서버 IP는 비인증 접근 차단됨 — 아래 중 하나 설정)
# 방법 A: Reddit 앱 OAuth (https://www.reddit.com/prefs/apps → script 타입)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# 방법 B: RSS 인증 (OAuth 승인 없이 가능)
# 1) old.reddit.com/prefs → "enable private RSS feeds" 켜기
# 2) old.reddit.com/prefs/feeds → "saved" 등 옆 URL 복사 (user= & feed= 포함)
# REDDIT_RSS_AUTH_URL=https://old.reddit.com/user/계정/saved.rss?feed=토큰&user=계정
# EC2에서 RSS 403이면 old.reddit HTML 폴백 시도. 그래도 안 되면:
# REDDIT_HTTP_PROXY=http://user:pass@proxy-host:port
# 또는 user/feed만 따로:
# REDDIT_RSS_USER=
# REDDIT_RSS_FEED=

# Elasticsearch — 전문 검색·챗봇 RAG
# SEARCH_BACKEND: postgres(기본) | elasticsearch | dual
SEARCH_BACKEND=postgres

# 로컬 docker: http://localhost:9200
# 관리형 클러스터: https://host:9200 + CA + 계정
ELASTICSEARCH_URL=https://your-es-host:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
# ca_certs.zip 압축 해제 경로 (파일 또는 디렉터리)
# python3 scripts/install_es_ca.py ~/Downloads/ca_certs.zip
ELASTICSEARCH_CA_CERTS=certs/elasticsearch/http_ca.crt
ELASTICSEARCH_VERIFY_CERTS=true

ELASTICSEARCH_INDEX_POSTS=mint-posts-v1
ELASTICSEARCH_INDEX_POSTS_ALIAS=mint-posts-current
ELASTICSEARCH_REQUEST_TIMEOUT_SEC=10
SEARCH_DUAL_LOG_DIFF=false
